# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods' plugins for Flutter
plugin 'cocoapods-deintegrate', :version => '1.0.5'
plugin 'cocoapods-generate',  :version => '0.1.0'

ENV['FLUTTER_ROOT'] = File.expand_path('..', __dir__)
load File.join(ENV['FLUTTER_ROOT'], '.flutter', 'scripts', 'flutter_cocoapods.rb')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end